load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# Declares a swift_library_group dep (LibraryGroup) that is never used.
# The tool should report UNUSED_DEP for the group.
swift_library(
    name = "UnusedLibraryGroupDep",
    srcs = ["UnusedLibraryGroupDep.swift"],
    module_name = "UnusedLibraryGroupDep",
    visibility = ["//cases:__subpackages__"],
    deps = [
        "//cases/Deps/TransitiveDep",
        "//cases/Deps/LibraryGroup",
    ],
)
