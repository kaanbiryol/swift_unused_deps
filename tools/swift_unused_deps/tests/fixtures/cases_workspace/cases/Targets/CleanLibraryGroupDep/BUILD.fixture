load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# Depends on a swift_library_group. The tool should resolve the group's
# primary module ("LibraryGroup") and report this target as CLEAN.
swift_library(
    name = "CleanLibraryGroupDep",
    srcs = ["CleanLibraryGroupDep.swift"],
    module_name = "CleanLibraryGroupDep",
    visibility = ["//cases:__subpackages__"],
    deps = ["//cases/Deps/LibraryGroup"],
)
