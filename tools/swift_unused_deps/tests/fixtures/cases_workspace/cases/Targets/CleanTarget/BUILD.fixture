load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# CLEAN - all deps are actually used.
swift_library(
    name = "CleanTarget",
    srcs = ["CleanTarget.swift"],
    module_name = "CleanTarget",
    visibility = ["//cases:__subpackages__"],
    deps = [
        "//cases/Deps/DirectDepWithTransitive",
        "//cases/Deps/LibB",
        "//cases/Deps/TransitiveDep",
    ],
)
