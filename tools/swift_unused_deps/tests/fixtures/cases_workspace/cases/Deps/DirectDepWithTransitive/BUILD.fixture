load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# Depends on TransitiveDep and re-exports its types through its public API.
swift_library(
    name = "DirectDepWithTransitive",
    srcs = ["DirectDepWithTransitive.swift"],
    module_name = "DirectDepWithTransitive",
    deps = ["//cases/Deps/TransitiveDep"],
    visibility = ["//cases:__subpackages__"],
)
