load("@build_bazel_rules_swift//swift:swift.bzl", "swift_binary", "swift_library")

swift_library(
    name = "SwiftUnusedDepsLib",
    srcs = [
        "Sources/AnalysisModels.swift",
        "Sources/Analyzer.swift",
        "Sources/BatchAnalyzer.swift",
        "Sources/Buildozer.swift",
        "Sources/IndexStoreReader.swift",
        "Sources/LabelConverter.swift",
        "Sources/MetadataModels.swift",
        "Sources/ModuleResolver.swift",
        "Sources/Report.swift",
        "Sources/SourceImportEditor.swift",
        "Sources/SwiftUnusedDepsCommand.swift",
        "Sources/TargetFilter.swift",
        "Sources/TraceParser.swift",
        "Sources/TraceModels.swift",
    ],
    module_name = "SwiftUnusedDepsLib",
    visibility = ["//tools/swift_unused_deps:__subpackages__"],
    deps = [
        "@swift-index-store//:IndexStore",
        "@swift_argument_parser//:ArgumentParser",
        "@SwiftSyntax//:SwiftParser",
        "@SwiftSyntax//:SwiftSyntax",
    ],
)

alias(
    name = "cli",
    actual = ":swift_unused_deps",
    visibility = ["//visibility:public"],
)

swift_binary(
    name = "swift_unused_deps",
    srcs = ["Sources/Main.swift"],
    data = ["@buildozer_binary//:buildozer.exe"],
    deps = [":SwiftUnusedDepsLib"],
    visibility = ["//visibility:public"],
)
