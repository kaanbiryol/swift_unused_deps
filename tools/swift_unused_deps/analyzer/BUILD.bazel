load("@build_bazel_rules_swift//swift:swift.bzl", "swift_binary", "swift_library")

swift_library(
    name = "SwiftUnusedDepsLib",
    srcs = [
        "Sources/Analyzer.swift",
        "Sources/Models.swift",
        "Sources/ModuleResolver.swift",
        "Sources/Report.swift",
        "Sources/TraceParser.swift",
    ],
    module_name = "SwiftUnusedDepsLib",
    visibility = ["//tools/swift_unused_deps:__subpackages__"],
)

swift_binary(
    name = "cli",
    srcs = ["Sources/CLI.swift"],
    deps = [
        ":SwiftUnusedDepsLib",
        "@swift_argument_parser//:ArgumentParser",
    ],
    visibility = ["//visibility:public"],
)

swift_binary(
    name = "swift_unused_deps",
    srcs = ["Sources/ReportCLI.swift"],
    deps = [":SwiftUnusedDepsLib"],
    visibility = ["//visibility:public"],
)
