load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# CANDIDATE PRIVATE DEP - TransitiveDep is declared as a dep but source only
# imports DirectDepWithTransitive. The compiler loads TransitiveDep indirectly
# because DirectDepWithTransitive's public API uses the User type.
swift_library(
    name = "CandidatePrivateDep",
    srcs = ["CandidatePrivateDep.swift"],
    deps = [
        "//example/Deps/DirectDepWithTransitive",
        "//example/Deps/TransitiveDep",
    ],
    visibility = ["//visibility:public"],
)
