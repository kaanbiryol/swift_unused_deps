load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# UNUSED IMPORT - Analytics is imported in source but no symbols from it are
# referenced. The trace-only analysis cannot detect this because the compiler
# loads Analytics.swiftmodule due to the import statement. Only index store
# analysis can catch it by verifying no symbols from Analytics are used.
swift_library(
    name = "Onboarding",
    srcs = ["OnboardingView.swift"],
    visibility = ["//visibility:public"],
    deps = [
        "//example/Core/Analytics",      # Unused - imported but no symbols referenced (index store detects this)
        "//example/Core/DesignSystem",
    ],
)
