load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# CANDIDATE PRIVATE DEP - Models is declared as a dep but source only imports
# Networking. The compiler loads Models indirectly because Networking's public
# interface uses the User type from Models.
swift_library(
    name = "Feed",
    srcs = ["FeedView.swift"],
    deps = [
        "//example/Core/Networking",
        "//example/Core/Models",
    ],
    visibility = ["//visibility:public"],
)
